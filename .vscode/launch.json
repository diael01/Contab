    "version": "0.2.0",
    "configurations": [
        {
            "name": "Server",//".NET Core Launch (web)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/BackEnd/ContabApi/bin/Debug/net8.0/ContabApi.dll",
            "args": [],
            "cwd": "${workspaceFolder}/BackEnd/ContabApi",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
